# Muse Mate — environment variables
# Copy to .env.local and fill in. Stripe vars are intentionally absent in v1
# (no billing); add them when billing is actually built.

# --- Supabase (DB + Auth) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-side only, never expose client-side

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000   # Vercel preview URL in dev, domain at launch

# --- Resend (transactional + auth email) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@themusemate.com   # one verified sending domain per product

# --- Web Push / VAPID (generate once: npx web-push generate-vapid-keys) ---
NEXT_PUBLIC_VAPID_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@themusemate.com

# --- Anthropic (server-side only) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5     # platform doc lists a stale id; override here
